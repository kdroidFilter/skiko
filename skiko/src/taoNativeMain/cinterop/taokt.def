package = io.github.kdroidfilter.taokt.native

# Headers from the taokt Rust library
# The actual header is generated by UniFFI during the build process
headers = taokt.h

# Static library to link
staticLibraries = libtaokt.a

# Library paths - these will be set by the build system
# libraryPaths =

# Compiler options
compilerOpts = -DTAOKT_STATIC

# Linker options depend on the platform
linkerOpts.osx = -framework Metal -framework CoreGraphics -framework AppKit -framework QuartzCore
linkerOpts.linux = -lX11 -lxcb -ldl -lpthread
linkerOpts.mingw = -luser32 -lgdi32 -ldwmapi
